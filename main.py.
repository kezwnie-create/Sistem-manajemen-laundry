
# ==================================================
# SISTEM MANAJEMEN LAUNDRY BERBASIS PYTHON OOP
# ==================================================

# CLASS PELANGGAN
class Pelanggan:
    def __init__(self, nama: str, no_hp: str) -> None:
        self.nama = nama
        self.no_hp = no_hp

    # Property dan Setter
    @property
    def nama(self) -> str:
        return self.__nama

    @nama.setter
    def nama(self, nilai: str) -> None:
        if not nilai.strip():
            raise ValueError("Nama tidak boleh kosong!")
        self.__nama = nilai.strip()

    @property
    def no_hp(self) -> str:
        return self.__no_hp

    @no_hp.setter
    def no_hp(self, nilai: str) -> None:
        if not nilai.strip():
            raise ValueError("Nomor HP tidak boleh kosong!")
        self.__no_hp = nilai.strip()

    def tampilkan_data(self) -> None:
        print("Nama pelanggan:", self.nama)
        print("Nomor HP:", self.no_hp)


# CLASS PESANAN
class Pesanan:
    def __init__(
        self,
        pelanggan: Pelanggan,
        layanan: str,
        berat: float,
        total: int
    ) -> None:
        self.pelanggan = pelanggan
        self.layanan = layanan
        self.berat = berat
        self.total = total
        self.status = "Sedang Diproses"


# CLASS LAUNDRY
class Laundry:
    def __init__(self, nama_toko: str) -> None:
        self.nama_toko = nama_toko
        self.daftar_pesanan: list[Pesanan] = []

    # Class Method
    @classmethod
    def toko_default(cls) -> "Laundry":
        return cls("Laundry Bersih Wangi")

    # Static Method
    @staticmethod
    def hitung_biaya(berat: float, harga: int) -> int:
        return round(berat * harga)

    @staticmethod
    def format_rupiah(angka: int) -> str:
        return "Rp" + format(angka, ",").replace(",", ".")

    # Menambahkan pesanan
    def tambah_pesanan(
        self,
        pelanggan: Pelanggan,
        layanan: str,
        berat: float
    ) -> None:

        harga_layanan: dict[str, int] = {
            "Cuci Kering": 7000,
            "Cuci Setrika": 10000,
            "Setrika": 5000
        }

        if berat <= 0:
            print("Berat harus lebih dari 0 kg!")
            return

        if layanan not in harga_layanan:
            print("Jenis layanan tidak tersedia!")
            return

        harga = harga_layanan[layanan]
        total = self.hitung_biaya(berat, harga)

        pesanan = Pesanan(
            pelanggan,
            layanan,
            berat,
            total
        )

        self.daftar_pesanan.append(pesanan)

        print("\nPesanan berhasil ditambahkan!")
        print("Nama:", pelanggan.nama)
        print("Layanan:", layanan)
        print("Berat:", berat, "kg")
        print("Total:", self.format_rupiah(total))

    # Menampilkan semua pesanan
    def tampilkan_pesanan(self) -> None:
        if not self.daftar_pesanan:
            print("\nBelum ada pesanan.")
            return

        print("\n================================")
        print("      DAFTAR PESANAN LAUNDRY")
        print("================================")

        for nomor, pesanan in enumerate(
            self.daftar_pesanan, start=1
        ):
            print("\nNomor pesanan:", nomor)
            print("Nama:", pesanan.pelanggan.nama)
            print("Nomor HP:", pesanan.pelanggan.no_hp)
            print("Layanan:", pesanan.layanan)
            print("Berat:", pesanan.berat, "kg")
            print("Total:", self.format_rupiah(pesanan.total))
            print("Status:", pesanan.status)

    # Mengubah status pesanan
    def ubah_status(self, nomor: int, status: str) -> None:
        if nomor < 1 or nomor > len(self.daftar_pesanan):
            print("Pesanan tidak ditemukan!")
            return

        pilihan_status = [
            "Sedang Diproses",
            "Selesai",
            "Sudah Diambil"
        ]

        if status not in pilihan_status:
            print("Status tidak valid!")
            return

        self.daftar_pesanan[nomor - 1].status = status

        print("Status pesanan berhasil diperbarui!")


# ==================================================
# PROGRAM UTAMA
# ==================================================

def main() -> None:
    laundry = Laundry.toko_default()

    while True:
        print("\n================================")
        print("    SISTEM MANAJEMEN LAUNDRY")
        print("================================")
        print("1. Tambah Pesanan")
        print("2. Tampilkan Pesanan")
        print("3. Ubah Status Pesanan")
        print("4. Keluar")

        pilihan = input("\nPilih menu: ")

        if pilihan == "1":
            try:
                nama = input("Nama pelanggan: ")
                no_hp = input("Nomor HP: ")

                pelanggan = Pelanggan(nama, no_hp)

                print("\nJENIS LAYANAN")
                print("Cuci Kering  : Rp7.000/kg")
                print("Cuci Setrika : Rp10.000/kg")
                print("Setrika      : Rp5.000/kg")

                layanan = input("\nPilih layanan: ")
                berat = float(input("Berat pakaian (kg): "))

                laundry.tambah_pesanan(
                    pelanggan,
                    layanan,
                    berat
                )

            except ValueError as error:
                print("Input tidak valid:", error)

        elif pilihan == "2":
            laundry.tampilkan_pesanan()

        elif pilihan == "3":
            laundry.tampilkan_pesanan()

            try:
                nomor = int(input("\nNomor pesanan: "))
                status = input(
                    "Status baru: "
                )

                laundry.ubah_status(nomor, status)

            except ValueError:
                print("Masukkan nomor yang benar!")

        elif pilihan == "4":
            print("\nTerima kasih telah menggunakan")
            print("Sistem Manajemen Laundry!")
            break

        else:
            print("Pilihan tidak tersedia!")


# Menjalankan program
if __name__ == "__main__":
    main()
